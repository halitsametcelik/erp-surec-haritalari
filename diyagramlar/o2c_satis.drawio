<mxfile><diagram name="O2C"><mxGraphModel background="#ffffff" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Satış Süreci · Order-to-Cash (O2C)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5a6477&quot; style=&quot;font-size:13px&quot;&gt;Her adımın stok, cari ve muhasebe etkisi&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#18202e;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Satış Teklifi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a47c4;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#18202e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Stok:&lt;/b&gt; değişmez&lt;br&gt;&lt;b&gt;Cari:&lt;/b&gt; değişmez&lt;br&gt;&lt;b&gt;Muhasebe:&lt;/b&gt; kayıt yok" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#c5cbd6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#18202e;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="84" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#c5cbd6;dashed=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="Satış Siparişi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2a47c4;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#18202e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="200" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Stok:&lt;/b&gt; rezerve edilir (fiziksel değişmez)&lt;br&gt;&lt;b&gt;Cari:&lt;/b&gt; değişmez&lt;br&gt;&lt;b&gt;Muhasebe:&lt;/b&gt; kayıt yok" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#c5cbd6;align=left;v